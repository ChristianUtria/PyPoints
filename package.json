{
  "name": "pypoints",
  "displayName": "PyPoints - Python API Tester & Endpoint Explorer",
  "description": "Professional Python API explorer and project visualizer for Flask, FastAPI & Django. Map endpoints, test routes, instantly copy complex project structures, and visualize architecture with an interactive, centralized project tree.",
  "version": "1.5.1",
  "sponsor": {
    "url": "https://github.com/sponsors/ChristianUtria"
  },
  "publisher": "christian-dev",
  "license": "MIT",
  "keywords": [
    "python",
    "api",
    "rest api",
    "flask",
    "fastapi",
    "django",
    "endpoint testing",
    "route explorer",
    "project tree",
    "structure visualization",
    "copy structure",
    "clipboard",
    "quick copy",
    "codelens",
    "curl generator",
    "api testing",
    "productivity",
    "backend tools",
    "documentation",
    "web development"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "icon": "media/logotipo_v4.png",
  "galleryBanner": {
    "color": "#0D1117",
    "theme": "dark"
  },
  "qna": "marketplace",
  "activationEvents": [
    "onCommand:endpointCounter.refresh",
    "onCommand:pypoints.codeLensCopyCurl",
    "onCommand:pypoints.codeLensCopyRoute",
    "onCommand:pypoints.copyStructureFromContext",
    "onCommand:pypoints.refreshCodeLens",
    "onCommand:pypoints.showProjectTree",
    "onCommand:pypoints.showStructure",
    "onView:endpointExplorer",
    "onView:endpointSummary",
    "onView:pypointsMain",
    "onView:pypointsStructure",
    "onView:pypoints.treeView"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChristianUtria/PyPoints.git"
  },
  "homepage": "https://github.com/ChristianUtria/PyPoints",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "endpointCounter",
          "title": "PyPoints",
          "icon": "media/brujula.svg"
        },
        {
          "id": "pypointsExplorer",
          "title": "PyPoints Explorer",
          "icon": "media/estructura_icon.svg"
        }
      ]
    },
    "views": {"explorer": [ 
    {
      "id": "pypointsStructure",
      "name": "PyPoints: Project Structure",
      "type": "webview",
      "visibility": "visible"
    }
  ],
      "endpointCounter": [
        {
          "id": "endpointExplorer",
          "name": "Endpoints",
          "icon": "media/brujula.svg",
          "contextualTitle": "PyPoints Explorer",
          "visibility": "visible"
        },
        {
          "id": "endpointSummary",
          "name": "Resumen",
          "visibility": "collapsed"
        }
      ],
      "pypointsExplorer": [
        {
          "id": "pypointsMain",
          "name": "Files",
          "type": "webview",
          "visibility": "visible"
        },
        {
          "id": "pypointsStructure",
          "name": "Project Structure",
          "type": "webview",
          "visibility": "visible"
        },
        {
          "id": "pypoints.treeView",
          "name": "AI Context",
          "type": "tree",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "PyPoints",
      "properties": {
        "pypoints.baseUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "URL base para construir los cURLs desde el CodeLens"
        },
        "pypoints.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar CodeLens (Run | Test | Copy) sobre cada endpoint en el editor"
        },
        "pypoints.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "API key de Anthropic para resumir archivos con Claude (botón ✨ IA en el panel Files).",
          "markdownDescription": "Tu [API key de Anthropic](https://console.anthropic.com/settings/keys). Necesaria para el botón **✨ IA (Claude)** en el panel de archivos. Se guarda en tu configuración local de VS Code."
        },
        "pypoints.claudeApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key for the AI Context panel (Summarize with Claude, Optimize & Copy).",
          "markdownDescription": "Tu [API key de Anthropic](https://console.anthropic.com/settings/keys) para el panel **AI Context** → botón *Summarize with Claude*. Si ya tienes `pypoints.anthropicApiKey` configurada, también funciona."
        },
        "pypoints.defaultProfile": {
          "type": "string",
          "enum": ["fast", "balanced", "ai_max"],
          "default": "balanced",
          "description": "Perfil de optimización por defecto para el panel AI Context.",
          "enumDescriptions": [
            "Fast: elimina comentarios, líneas vacías y espacios extra",
            "Balanced: Fast + JSON compacto, detección de patrones, truncado",
            "AI Max: Balanced + resumen de logs, compresión agresiva"
          ]
        }
      }
    },
    "commands": [
      {
        "command": "endpointCounter.refresh",
        "title": "Refrescar Endpoints",
        "icon": "$(refresh)"
      },
      {
        "command": "endpointCounter.scanWorkspace",
        "title": "Escaner Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "endpointCounter.copyRoute",
        "title": "Copiar Route",
        "icon": "$(copy)"
      },
      {
        "command": "endpointCounter.copyCurl",
        "title": "Copiar cURL",
        "icon": "$(terminal)"
      },
      {
        "command": "endpointCounter.peekCode",
        "title": "Preview Code",
        "icon": "$(open-preview)"
      },
      {
        "command": "endpointCounter.runGetTest",
        "title": "Test API Endpoint",
        "icon": "$(play)"
      },
      {
        "command": "endpointCounter.search",
        "title": "Buscar Endpoints",
        "icon": "$(search)"
      },
      {
        "command": "endpointCounter.filterByMethod",
        "title": "Filtrar por HTTP Method",
        "icon": "$(filter)"
      },
      {
        "command": "endpointCounter.showOnlyIssues",
        "title": "Mostrar solo problemas",
        "icon": "$(error)"
      },
      {
        "command": "endpointCounter.clearFilters",
        "title": "Limpiar filtros",
        "icon": "$(clear-all)"
      },
      {
        "command": "endpointCounter.exportJson",
        "title": "Exportar en Json",
        "icon": "$(export)"
      },
      {
        "command": "endpointCounter.exportMarkdown",
        "title": "Exportar en Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "endpointCounter.groupByCategory",
        "title": "Agrupar por categoria"
      },
      {
        "command": "endpointCounter.groupByFile",
        "title": "Agrupar por archivo"
      },
      {
        "command": "pypoints.showStructure",
        "title": "PyPoints: Ver estructura del proyecto",
        "icon": "media/structure-icon.svg"
      },
      {
        "command": "pypoints.copyStructureFromContext",
        "title": "Copiar estructura desde PyPoints"
      },
      {
        "command": "pypoints.codeLensCopyRoute",
        "title": "PyPoints: Copiar Ruta"
      },
      {
        "command": "pypoints.codeLensCopyCurl",
        "title": "PyPoints: Copiar cURL"
      },
      {
        "command": "pypoints.refreshCodeLens",
        "title": "PyPoints: Refresh CodeLens"
      },
      {
        "command": "pypoints.showProjectTree",
        "title": "PyPoints: 🌳 Ver árbol del proyecto",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "pypoints.addFileToContext",
        "title": "Add to PyPoints Context",
        "category": "PyPoints",
        "icon": "$(add)"
      },
      {
        "command": "pypoints.removeFileFromContext",
        "title": "Remove from Context",
        "category": "PyPoints",
        "icon": "$(remove)"
      },
      {
        "command": "pypoints.clearSelection",
        "title": "Clear Selection",
        "category": "PyPoints",
        "icon": "$(clear-all)"
      },
      {
        "command": "pypoints.copyFiles",
        "title": "Copy Selected Files",
        "category": "PyPoints",
        "icon": "$(copy)"
      },
      {
        "command": "pypoints.optimizeAndCopy",
        "title": "Optimize & Copy",
        "category": "PyPoints",
        "icon": "$(zap)"
      },
      {
        "command": "pypoints.summarizeFiles",
        "title": "Summarize with Claude",
        "category": "PyPoints",
        "icon": "$(sparkle)"
      },
      {
        "command": "pypoints.previewOptimization",
        "title": "Preview Optimization",
        "category": "PyPoints",
        "icon": "$(eye)"
      },
      {
        "command": "pypoints.excludeFile",
        "title": "Exclude from Context",
        "category": "PyPoints",
        "icon": "$(circle-slash)"
      },
      {
        "command": "pypoints.includeFile",
        "title": "Include in Context",
        "category": "PyPoints",
        "icon": "$(check)"
      },
      {
        "command": "pypoints.clearExclusions",
        "title": "Clear All Exclusions",
        "category": "PyPoints"
      },
      {
        "command": "pypoints.analyzeFile",
        "title": "Analyze Token Usage",
        "category": "PyPoints",
        "icon": "$(graph)"
      },
      {
        "command": "pypoints.copyOptimized",
        "title": "Copy Optimized",
        "category": "PyPoints",
        "icon": "$(copy)"
      },
      {
        "command": "pypoints.analyzeDependencies",
        "title": "Analyze Dependencies",
        "category": "PyPoints",
        "icon": "$(references)"
      },
      {
        "command": "pypoints.showTokenUsage",
        "title": "Show Token Usage",
        "category": "PyPoints",
        "icon": "$(symbol-number)"
      },
      {
        "command": "pypoints.selectProfile",
        "title": "Select Optimization Profile",
        "category": "PyPoints",
        "icon": "$(settings-gear)"
      },
      {
        "command": "pypoints.setProfile",
        "title": "Set Optimization Profile",
        "category": "PyPoints"
      },
      {
        "command": "pypoints.openFile",
        "title": "Open File",
        "category": "PyPoints"
      }
    ],
    "menus": {
      "explorer/title": [
        {
          "command": "pypoints.showStructure",
          "group": "navigation@1",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "pypoints.showProjectTree",
          "group": "navigation@2",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "explorer/context": [
        {
          "command": "pypoints.copyStructureFromContext",
          "group": "5_cutcopypaste@99",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "pypoints.addFileToContext",
          "group": "5_cutcopypaste@100",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "view/title": [
        {
          "command": "endpointCounter.refresh",
          "when": "view == endpointExplorer",
          "group": "navigation@1"
        },
        {
          "command": "endpointCounter.scanWorkspace",
          "when": "view == endpointExplorer",
          "group": "navigation@2"
        },
        {
          "command": "endpointCounter.search",
          "when": "view == endpointExplorer",
          "group": "navigation@3"
        },
        {
          "command": "endpointCounter.filterByMethod",
          "when": "view == endpointExplorer",
          "group": "navigation@4"
        },
        {
          "command": "endpointCounter.showOnlyIssues",
          "when": "view == endpointExplorer",
          "group": "navigation@5"
        },
        {
          "command": "endpointCounter.clearFilters",
          "when": "view == endpointExplorer",
          "group": "navigation@6"
        },
        {
          "command": "endpointCounter.groupByCategory",
          "when": "view == endpointExplorer",
          "group": "2_group@1"
        },
        {
          "command": "endpointCounter.groupByFile",
          "when": "view == endpointExplorer",
          "group": "2_group@2"
        },
        {
          "command": "endpointCounter.exportJson",
          "when": "view == endpointExplorer",
          "group": "3_export@1"
        },
        {
          "command": "endpointCounter.exportMarkdown",
          "when": "view == endpointExplorer",
          "group": "3_export@2"
        },
        {
          "command": "pypoints.showStructure",
          "when": "view == pypointsStructure",
          "group": "navigation"
        },
        {
          "command": "pypoints.optimizeAndCopy",
          "when": "view == pypoints.treeView",
          "group": "navigation@1"
        },
        {
          "command": "pypoints.clearSelection",
          "when": "view == pypoints.treeView",
          "group": "navigation@2"
        },
        {
          "command": "pypoints.selectProfile",
          "when": "view == pypoints.treeView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "endpointCounter.goToLine",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "navigation@1"
        },
        {
          "command": "endpointCounter.peekCode",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "navigation@2"
        },
        {
          "command": "endpointCounter.runGetTest",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "navigation@3"
        },
        {
          "command": "endpointCounter.copyRoute",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "inline@1"
        },
        {
          "command": "endpointCounter.copyCurl",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "inline@2"
        },
        {
          "command": "endpointCounter.runGetTest",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "inline@3"
        },
        {
          "command": "pypoints.copyOptimized",
          "when": "view == pypoints.treeView && viewItem == pypoints.fileItem",
          "group": "pypoints@1"
        },
        {
          "command": "pypoints.previewOptimization",
          "when": "view == pypoints.treeView && viewItem == pypoints.fileItem",
          "group": "pypoints@2"
        },
        {
          "command": "pypoints.analyzeFile",
          "when": "view == pypoints.treeView && viewItem == pypoints.fileItem",
          "group": "pypoints@3"
        },
        {
          "command": "pypoints.showTokenUsage",
          "when": "view == pypoints.treeView && viewItem == pypoints.fileItem",
          "group": "pypoints@4"
        },
        {
          "command": "pypoints.excludeFile",
          "when": "view == pypoints.treeView && viewItem == pypoints.fileItem",
          "group": "pypoints@5"
        },
        {
          "command": "pypoints.analyzeDependencies",
          "when": "view == pypoints.treeView && viewItem == pypoints.fileItem",
          "group": "pypoints@6"
        },
        {
          "command": "pypoints.removeFileFromContext",
          "when": "view == pypoints.treeView && viewItem == pypoints.fileItem",
          "group": "pypoints_remove@1"
        },
        {
          "command": "pypoints.includeFile",
          "when": "view == pypoints.treeView && viewItem == pypoints.excludedItem",
          "group": "pypoints@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.0.0"
  }
}