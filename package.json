{
  "name": "pypoints",
  "displayName": "PyPoints - Python API Tester & Endpoint Explorer",
  "description": "Detect, test & manage REST API endpoints in Flask, FastAPI and Django. CodeLens overlays, cURL generator, route explorer, duplicate detection, JSON body editor, project tree visualizer, export to JSON/Markdown. The Postman alternative built into VS Code.",
  "version": "2.2.0",
  "publisher": "christian-dev",
  "license": "MIT",
  "sponsor": {
    "url": "https://github.com/sponsors/ChristianUtria"
  },
  "keywords": [
    "python",
    "api",
    "rest api",
    "flask",
    "fastapi",
    "django",
    "endpoint testing",
    "route explorer",
    "api testing",
    "http client",
    "curl generator",
    "codelens",
    "postman alternative",
    "swagger",
    "openapi",
    "route testing",
    "api explorer",
    "backend tools",
    "project tree",
    "structure visualization",
    "copy structure",
    "clipboard",
    "productivity",
    "web development",
    "blueprint",
    "router",
    "decorator",
    "uvicorn",
    "gunicorn",
    "rest client"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization",
    "Linters",
    "Other"
  ],
  "icon": "media/logotipo_v4.png",
  "galleryBanner": {
    "color": "#0D1117",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChristianUtria/PyPoints.git"
  },
  "homepage": "https://github.com/ChristianUtria/PyPoints",
  "activationEvents": [
    "onLanguage:python",
    "onCommand:endpointCounter.refresh",
    "onCommand:pypointsEndpoints.codeLensCopyCurl",
    "onCommand:pypointsEndpoints.codeLensCopyRoute",
    "onCommand:pypointsEndpoints.refreshCodeLens",
    "onView:endpointExplorer",
    "onView:endpointSummary"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "endpointCounter",
          "title": "PyPoints Endpoints",
          "icon": "media/brujula.svg"
        }
      ]
    },
    "views": {
      "endpointCounter": [
        {
          "id": "endpointExplorer",
          "name": "Endpoints",
          "icon": "media/brujula.svg",
          "contextualTitle": "PyPoints Endpoints",
          "visibility": "visible"
        },
        {
          "id": "endpointSummary",
          "name": "Resumen",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "PyPoints Endpoints",
      "properties": {
        "pypointsEndpoints.baseUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "URL base para construir los cURLs desde el CodeLens"
        },
        "pypointsEndpoints.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar CodeLens (Run | Test | Copy) sobre cada endpoint en el editor"
        }
      }
    },
    "commands": [
      {
        "command": "endpointCounter.refresh",
        "title": "Refrescar Endpoints",
        "icon": "$(refresh)"
      },
      {
        "command": "endpointCounter.scanWorkspace",
        "title": "Escaner Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "endpointCounter.copyRoute",
        "title": "Copiar Route",
        "icon": "$(copy)"
      },
      {
        "command": "endpointCounter.copyCurl",
        "title": "Copiar cURL",
        "icon": "$(terminal)"
      },
      {
        "command": "endpointCounter.peekCode",
        "title": "Preview Code",
        "icon": "$(open-preview)"
      },
      {
        "command": "endpointCounter.runGetTest",
        "title": "Test API Endpoint",
        "icon": "$(play)"
      },
      {
        "command": "endpointCounter.search",
        "title": "Buscar Endpoints",
        "icon": "$(search)"
      },
      {
        "command": "endpointCounter.filterByMethod",
        "title": "Filtrar por HTTP Method",
        "icon": "$(filter)"
      },
      {
        "command": "endpointCounter.showOnlyIssues",
        "title": "Mostrar solo problemas",
        "icon": "$(error)"
      },
      {
        "command": "endpointCounter.clearFilters",
        "title": "Limpiar filtros",
        "icon": "$(clear-all)"
      },
      {
        "command": "endpointCounter.exportJson",
        "title": "Exportar en Json",
        "icon": "$(export)"
      },
      {
        "command": "endpointCounter.exportMarkdown",
        "title": "Exportar en Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "endpointCounter.groupByCategory",
        "title": "Agrupar por categoria"
      },
      {
        "command": "endpointCounter.groupByFile",
        "title": "Agrupar por archivo"
      },
      {
        "command": "pypointsEndpoints.codeLensCopyRoute",
        "title": "PyPoints: Copiar Ruta"
      },
      {
        "command": "pypointsEndpoints.codeLensCopyCurl",
        "title": "PyPoints: Copiar cURL"
      },
      {
        "command": "pypointsEndpoints.refreshCodeLens",
        "title": "PyPoints: Refresh CodeLens"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "endpointCounter.refresh",
          "when": "view == endpointExplorer",
          "group": "navigation@1"
        },
        {
          "command": "endpointCounter.scanWorkspace",
          "when": "view == endpointExplorer",
          "group": "navigation@2"
        },
        {
          "command": "endpointCounter.search",
          "when": "view == endpointExplorer",
          "group": "navigation@3"
        },
        {
          "command": "endpointCounter.filterByMethod",
          "when": "view == endpointExplorer",
          "group": "navigation@4"
        },
        {
          "command": "endpointCounter.showOnlyIssues",
          "when": "view == endpointExplorer",
          "group": "navigation@5"
        },
        {
          "command": "endpointCounter.clearFilters",
          "when": "view == endpointExplorer",
          "group": "navigation@6"
        },
        {
          "command": "endpointCounter.groupByCategory",
          "when": "view == endpointExplorer",
          "group": "2_group@1"
        },
        {
          "command": "endpointCounter.groupByFile",
          "when": "view == endpointExplorer",
          "group": "2_group@2"
        },
        {
          "command": "endpointCounter.exportJson",
          "when": "view == endpointExplorer",
          "group": "3_export@1"
        },
        {
          "command": "endpointCounter.exportMarkdown",
          "when": "view == endpointExplorer",
          "group": "3_export@2"
        }
      ],
      "view/item/context": [
        {
          "command": "endpointCounter.peekCode",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "navigation@1"
        },
        {
          "command": "endpointCounter.runGetTest",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "navigation@2"
        },
        {
          "command": "endpointCounter.copyRoute",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "inline@1"
        },
        {
          "command": "endpointCounter.copyCurl",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "inline@2"
        },
        {
          "command": "endpointCounter.runGetTest",
          "when": "view == endpointExplorer && viewItem =~ /endpoint/",
          "group": "inline@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node build.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.0.0",
    "javascript-obfuscator": "^5.4.3",
    "typescript": "^5.3.0"
  }
}
